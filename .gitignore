# Ignore all files by default
*
# Allow the .gitignore file itself
!.gitignore

!*/

# Ada
!*.adb
!*.ads

# C
!*.c
!*.h

# C++
!*.cpp
!*.hpp

# C#
*.cs
!Program.cs

# D
!*.d

# Go
!*.go

# Java
!*.java

# JavaScript
!*.js
!*.jsx

# Nim
!*.nim

# Python
!*.py

# PHP
!*.php

# Rust
!*.rs

# Zig
!*.zig

# OCaml
!*.ml

# Fortran
!*.f90

# Pascal
!*.pas

!*.sh

!*.nix
!flake.lock
!*.cff
!*.md
!LICENSE

# Build caches (after !*/ so the directories are re-ignored)
nimcache/
.zig-cache/
zig-cache/
__pycache__/
out/
